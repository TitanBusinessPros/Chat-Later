rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — trial + payment status for one signed-in user.
    match /users/{uid} {

      // A user can only ever read their own record, never anyone else's.
      allow read: if request.auth != null && request.auth.uid == uid;

      // A user can create their own record when they first sign up,
      // but only with a fresh, unpaid trial — never isPaid: true.
      // (isPaid only ever flips to true server-side, from the Stripe
      // webhook Cloud Function using the Admin SDK, which bypasses
      // these rules entirely.)
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['trialStartMillis', 'isPaid'])
        && request.resource.data.isPaid == false
        && request.resource.data.trialStartMillis is number
        && request.resource.data.trialStartMillis <= request.time.toMillis()
        && request.resource.data.trialStartMillis > request.time.toMillis() - 86400000; // within the last day

      // The app never updates this doc after creation today — isPaid
      // flips server-side only. Block client-side updates and deletes.
      allow update, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
